# Copy to .env and adjust if needed. .env is gitignored; this file is not.
#
# The scripts read it via Node's own --env-file-if-exists, so no dotenv
# dependency — and they fall back to this same default when .env is absent.

# Matches docker-compose.yml: port 5433 on the host, to avoid colliding with a
# Postgres already listening on 5432.
DATABASE_URL=postgres://agentlab:agentlab@localhost:5433/agentlab

# Ollama runs on the host, not in Docker (Metal does not pass through to a
# container on macOS). This is its default address.
OLLAMA_URL=http://127.0.0.1:11434
